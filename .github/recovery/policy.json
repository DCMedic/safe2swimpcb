{
  "version": 3,
  "repository": "DCMedic/safe2swimpcb",
  "purpose": "Layered recovery policy for missed or delayed GitHub Actions schedules. Normal lane schedules remain primary; the in-repository recovery controller dispatches overdue workflows directly, while external trigger-file pushes remain an independent fallback. Active windows intentionally begin after the first normal daily schedule for lanes that pause overnight, preventing false morning recoveries.",
  "lanes": {
    "pcb": {
      "heartbeat_path": "data/current_flag.json",
      "heartbeat_field": "last_verified_at",
      "trigger_path": ".github/recovery/pcb.trigger",
      "workflow": "Poll current PCB beach flag",
      "workflow_path": ".github/workflows/poll-current-flag.yml",
      "overdue_minutes": 90,
      "cooldown_minutes": 120,
      "active_window": {
        "timezone": "America/Chicago",
        "start_hour": 7,
        "end_hour": 23
      },
      "failure_retry_minutes": 90
    },
    "destin": {
      "heartbeat_path": "data/destin/current_flag.json",
      "heartbeat_field": "last_verified_at",
      "trigger_path": ".github/recovery/destin.trigger",
      "workflow": "Poll current Destin beach flag",
      "workflow_path": ".github/workflows/poll-destin-flag.yml",
      "overdue_minutes": 100,
      "cooldown_minutes": 120,
      "failure_retry_minutes": 90
    },
    "eastern": {
      "heartbeat_path": "data/franklin-county/current_flag.json",
      "heartbeat_field": "last_verified_at",
      "trigger_path": ".github/recovery/eastern.trigger",
      "workflow": "Update eastern Panhandle flags",
      "workflow_path": ".github/workflows/update-eastern-panhandle.yml",
      "overdue_minutes": 110,
      "cooldown_minutes": 150,
      "failure_retry_minutes": 90
    },
    "southwest": {
      "heartbeat_path": "data/anna-maria-island/current_flag.json",
      "heartbeat_field": "last_verified_at",
      "trigger_path": ".github/recovery/southwest.trigger",
      "workflow": "Update Southwest Florida locations",
      "workflow_path": ".github/workflows/update-southwest-locations.yml",
      "overdue_minutes": 110,
      "cooldown_minutes": 150,
      "failure_retry_minutes": 90
    },
    "western": {
      "heartbeat_path": "data/okaloosa-island/current_flag.json",
      "heartbeat_field": "last_verified_at",
      "trigger_path": ".github/recovery/western.trigger",
      "workflow": "Update western Gulf data",
      "workflow_path": ".github/workflows/update-western-locations.yml",
      "overdue_minutes": 180,
      "cooldown_minutes": 240,
      "active_window": {
        "timezone": "America/Chicago",
        "start_hour": 8,
        "end_hour": 21
      },
      "failure_retry_minutes": 90
    },
    "x": {
      "heartbeat_path": "data/x_publisher_health.json",
      "heartbeat_field": "last_evaluated_at",
      "trigger_path": ".github/recovery/x.trigger",
      "workflow": "Publish Know the Gulf to X",
      "workflow_path": ".github/workflows/x-production-publisher.yml",
      "dispatch_inputs": {
        "mode": "publish",
        "slot": "auto"
      },
      "overdue_minutes": 300,
      "cooldown_minutes": 360,
      "active_window": {
        "timezone": "America/Chicago",
        "start_hour": 9,
        "end_hour": 21
      },
      "failure_retry_minutes": 90
    }
  }
}
