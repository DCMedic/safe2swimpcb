{
  "version": 6,
  "repository": "DCMedic/safe2swimpcb",
  "purpose": "Layered recovery policy for missed, delayed, or stuck GitHub Actions runs. Normal lane schedules remain primary; the in-repository recovery controller dispatches overdue workflows directly and cancels stale queued/in-progress runs. External repository-health recovery uses ordinary top-level recovery/*.trigger content files so integrations do not require special .github-path write handling. Legacy .github/recovery/*.trigger listeners remain temporarily for backward compatibility. Active windows intentionally begin after the first normal daily schedule for lanes that pause overnight, preventing false morning recoveries.",
  "lanes": {
    "pcb": {
      "heartbeat_path": "data/current_flag.json",
      "heartbeat_field": "last_verified_at",
      "trigger_path": "recovery/pcb.trigger",
      "workflow": "Poll current PCB beach flag",
      "workflow_path": ".github/workflows/poll-current-flag.yml",
      "overdue_minutes": 90,
      "cooldown_minutes": 120,
      "stuck_run_minutes": 25,
      "active_window": {
        "timezone": "America/Chicago",
        "start_hour": 7,
        "end_hour": 23
      },
      "failure_retry_minutes": 90
    },
    "destin": {
      "heartbeat_path": "data/destin/current_flag.json",
